  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "T\u1EEBng l\xE0 m\u1ED9t l\u1EADp tr\xECnh vi\xEAn gi\u1ECFi, Rin b\u1ECB
    \xE1p l\u1EF1c b\u1EDFi \u0111\u1ED1ng deadline v\xE0 l\u1ED1i s\u1ED1ng \u0111\u1ED9c
    h\u1EA1i. S\u1EE9c kh\u1ECFe ng\xE0y c\xE0ng sa s\xFAt cho n\xEAn Rin quy\u1EBFt
    \u0111\u1ECBnh t\u1EA1m d\u1EEBng c\xF4ng vi\u1EC7c l\u1EADp tr\xECnh \u0111\u1EC3
    t\xECm l\u1EA1i ch\xEDnh m\xECnh tr\u1EDF v\u1EC1 v\xF9ng qu\xEA y\xEAn b\xECnh.
    Cu\u1ED9c h\xE0nh tr\xECnh m\u1EDBi c\u1EE7a Rin v\u1EDBi trang tr\u1EA1i \u0111\u01B0\u1EE3c
    b\u1EAFt \u0111\u1EA7u t\u1EEB \u0111\xE2y."
  m_isRightToLeft: 0
